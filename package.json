{
  "name": "sandbox-console",
  "version": "0.1.0",
  "private": true,
  "description": "Local web console for coding agents in OpenShell sandboxes, over ACP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredrikp999/sandbox-console.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "vite build --config web/vite.config.ts && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "build": "vite build --config web/vite.config.ts",
    "dev": "tsx watch server/index.ts --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import tsx --test server/*.test.ts web/src/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "diff": "^9.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
