{
  "name": "sandbox-console",
  "version": "0.1.0",
  "private": true,
  "description": "Local web console for coding agents in OpenShell sandboxes, over ACP",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts --dev",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test server/*.test.ts web/src/*.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "diff": "^9.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
