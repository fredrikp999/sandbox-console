{
  // Shared compiler options. Each part of the repo has its own project, which extends this one:
  //   server/tsconfig.json     bridge and shared types: Node APIs, no DOM
  //   web/tsconfig.json        UI: DOM, no Node APIs
  //   web/tsconfig.node.json   UI tests and vite.config.ts: they run in Node, so both
  // `npm run typecheck` (tsc -b) checks all three.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [],
  "references": [{ "path": "./server" }, { "path": "./web" }, { "path": "./web/tsconfig.node.json" }]
}
